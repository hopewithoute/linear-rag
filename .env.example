# Database
FRUGAL_DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/linear_rag_db

# API
FRUGAL_API_KEY=

# Extraction
GLINER_MODEL=urchade/gliner_medium-v2.1
TERM_EXTRACTOR_BASE_URL=
TERM_EXTRACTOR_API_KEY=
TERM_EXTRACTOR_THRESHOLD=0.5
SPACY_MODEL=en_core_web_sm

# Embedding
EMBEDDING_BASE_URL=http://localhost:8001
EMBEDDING_API_KEY=
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B
EMBEDDING_DIMENSIONS=1024

# Chunking
CHUNK_SIZE_TOKENS=512
CHUNK_OVERLAP_TOKENS=96

# PPR
PPR_ALPHA=0.15
PPR_MAX_ITER=3
PPR_MAX_FRONTIER_NODES=50000
PPR_MAX_FRONTIER_EDGES=250000
PPR_MAX_HOPS=2

# Entity
MAX_ENTITIES_PER_CHUNK=32
MIN_ENTITY_LENGTH=2
MAX_ENTITY_DEGREE_PER_QUERY=500

# Snapshot
SNAPSHOT_DIR=./snapshots
SNAPSHOT_COMPILE_MODE=full

# Retrieval
VECTOR_TOP_K=50
BM25_TOP_K=50
FINAL_TOP_K=12
RRF_K=60
DENSE_WEIGHT=0.6
BM25_WEIGHT=0.4

# Mutation
TOMBSTONE_COMPACTION_THRESHOLD=0.30
